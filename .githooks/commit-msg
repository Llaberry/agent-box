#!/bin/sh
# commit-msg - refuse a commit message that credits a tool, BEFORE it exists.
#
# ⛔ THIS HOOK EXISTS BECAUSE THE GATE STRUCTURALLY CANNOT DO IT.
# The attribution check is the only one whose subject is `git log` rather than
# the tracked tree, and every session's procedure is "run the gate, then
# commit". At the moment the gate runs, the commit being made does not exist,
# so that check reads only old commits and is always green. It reports the
# defect afterwards, by which time the commit is made and possibly pushed.
#
# ⛔ INSTALL IT. Hooks are not cloned, so a fresh checkout has none until:
#
#   git config core.hooksPath .githooks
#
# ⛔ IT IS SELF-CONTAINED, ON PURPOSE. An earlier version of this file called a
# shell script under scripts/ that this repository does not ship. The result
# was a hook that exited 2 on every commit, good and bad alike: no attribution
# was ever checked, and the repository could not be committed to while the hook
# was armed. It fails closed, which is the safe direction, and it was still
# broken. Found by planting a tool-crediting message and watching what happened,
# which is docs/methodology/reviews.md lens 2.
#
# ⛔ IT REFUSES WHEN IT CANNOT RUN. git treats any non-zero exit as a rejection,
# so the only two honest answers a hook has are "checked and allowed" and "not
# allowed". A hook that exits 0 because it could not read the message has
# reported success over a message it never saw.
#
# ⚠ WHAT IT DOES NOT CATCH. It matches known shapes and known vendor names. A
# message crediting a tool in words it does not know passes, and that is a
# reading rather than a check. docs/conventions/git.md is the rule.
#
# Exit codes: 0 the message is allowed, 1 it is refused, 2 the check could not run.
#
# SPDX-License-Identifier: 0BSD

set -u

[ $# -ge 1 ] || {
  printf 'commit-msg: git passes the message file as $1 and did not\n' >&2
  exit 2
}
MSG="$1"
[ -r "$MSG" ] || {
  printf 'commit-msg: %s is not readable, so the message was NOT checked.\n' "$MSG" >&2
  printf '  That is "could not run" rather than a pass.\n' >&2
  exit 2
}

# Comment lines are stripped by git after this hook runs, so they are stripped
# here too. Otherwise the template git writes into the file, which names the
# branch and the files, is matched as though the author had typed it.
BODY=$(sed -e 's/^#.*//' "$MSG")

# ⛔ Two shapes and a name list. Each is a way the credit arrives from a default
# nobody chose, which is why this is a hard rule rather than a preference.
#   1. a trailer:            Co-Authored-By: <anything>
#   2. a generated-with line: Generated with / Co-authored by / 🤖
#   3. a vendor or tool name anywhere in the body
TRAILER='^[[:space:]]*(Co-[Aa]uthored-[Bb]y|Co-authored-by)[[:space:]]*:'
GENERATED='([Gg]enerated (with|by)|[Cc]reated (with|by) an? (AI|assistant|agent)|🤖)'
NAMES='([Cc]laude|[Aa]nthropic|[Cc]opilot|ChatGPT|[Oo]pen[Aa][Ii]|[Gg]emini|[Cc]ursor|[Dd]evin|Codex|[Aa]ider)'

refuse() {
  printf 'commit-msg: refused. %s\n' "$1" >&2
  printf '\n' >&2
  printf 'The commit was refused and nothing was written. Edit the message and\n' >&2
  printf 'commit again. The identity is the repository owner alone, whatever a\n' >&2
  printf "tool's own defaults ask for. docs/conventions/git.md is the rule.\n" >&2
  exit 1
}

printf '%s' "$BODY" | grep -Eq "$TRAILER" && refuse 'the message carries a co-author trailer.'
printf '%s' "$BODY" | grep -Eq "$GENERATED" && refuse 'the message says it was generated by a tool.'
printf '%s' "$BODY" | grep -Eq "$NAMES" && refuse 'the message names a tool or a vendor.'

exit 0
